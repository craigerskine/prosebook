{%- from 'macro.heading.njk' import heading -%}

<div class="divide-y divide-(--color-base-300)">
  {%- for item in main %}
    <div class="py-12 grid grid-cols-1 justify-between gap-12 md:grid-cols-12">
      <hgroup class="prose md:col-span-4">
      {%- set heading -%}## {{ item.title }} {.mb-0}
        {{ item.desc | safe }} { .text-current/60 .text-sm .text-pretty }
      {%- endset -%}
        {{ heading | md | safe }}
      </hgroup>
      <div class="md:col-span-8">
        {%- if item.items %}
          <div class="not-prose">
            <ul class="max-w-3xl divide-y divide-(--color-base-300)">
              {%- for sub in item.items %}
                <li class="py-8 flex flex-col items-start gap-8 relative [font-family:var(--prs-ff-{{ sub.type | lower }})] md:flex-row">
                  <strong class="text-xs text-gray-500 uppercase absolute top-2 left-0">{{ sub.type }}</strong>
                  <div class="text-3xl leading-none md:w-48 md:text-[6vw] leading-none)">Aa</div>
                  <div class="space-y-3">
                    <h2 class="text-xl font-semibold">{{ sub.title }}</h2>
                    <ul>
                      <li>ABCDEFGHIJKLMNOPQRSTUVWXYZ</li>
                      <li>abcdefghijklmnopqrstuvwxyz</li>
                      <li>(.,;:'"$#@!&*) 0123456789</li>
                    </ul>
                  </div>
                </li>
              {%- endfor %}
            </ul>
          </div>
        {%- endif %}
        {%- if item.code %}
          <div not-prose>
            {{ item.code | renderContent('md') | safe }}
          </div>
        {%- endif %}
        {%- if item.prose %}
          <div class="[&_iframe]:rounded-lg">
            {# {{ preview({
              version: site.version,
              height: '[800px]',
              start: false,
              html: '<div class="prose max-w-none">'+ (item.prose | renderContent('md') | safe)+ '</div>'
            }) }} #}
          </div>
        {%- endif %}
        {%- if item.title === 'Google Fonts Embed' %}
{%- set mockupCode -%}
```html
<link href="//fonts.googleapis.com" rel="preconnect" />
<link href="//fonts.gstatic.com" rel="preconnect" />
<link href="//fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Literata:ital,opsz,wght@0,7..72,200..900;1,7..72,200..900&display=swap" rel="stylesheet" />
```
{%- endset -%}
          <div>
            <div class="mockup-code">
              {{ mockupCode | renderContent('md') | safe }}
            </div>
          </div>
        {%- endif %}
        {%- if item.title === 'CSS' %}
{%- set mockupCode -%}
```css
--{{ prose.base.prefix }}-ff-sans: {{ prose.typography.sans | safe }};
--{{ prose.base.prefix }}-ff-serif: {{ prose.typography.serif | safe }};
--{{ prose.base.prefix }}-ff-mono: {{ prose.typography.mono | safe }};
--{{ prose.base.prefix }}-ff-websafe: {{ prose.typography.websafe | safe }};
```
{%- endset -%}
          <div>
            <div class="mockup-code">
              {{ mockupCode | renderContent('md') | safe }}
            </div>
          </div>
        {%- endif %}
      </div>
    </div>
  {%- endfor %}
</div>
