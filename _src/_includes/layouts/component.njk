---
layout: layouts/_base.njk
---

{%- macro heading(param) -%}
<h2 class="text-gray-500 text-xs font-bold uppercase">{{ param.slot | safe }}</h2>
{%- endmacro -%}

{%- if content %}  
  <article class="prose">
    {{ content | safe }}
  </article>
{%- endif %}

{%- if controls %}
  <div
    x-data="story({
      {%- for c in controls %}
        {{ c.name }}: {{ c.default | dump }}{% if not loop.last %},{% endif %}
      {%- endfor %},
      tabs: [
        { title: 'Preview', ico: 'mdi:eye', },
        { title: 'Styles', ico: 'mdi:language-css3', },
      ],
      tabActive: 1,
      tabId: $id('tab'),
    })"
    x-id="['tab']"
  >
    <div>
      <div class="mb-4 flex items-center justify-between gap-2">
        {%- include '_tabs.njk' -%}
        <div class="flex items-center gap-2">
          <div class="relative z-20">
            <div class="dropdown dropdown-end focus-within:[&_.btn]:bg-(--color-base-300)">
              <div tabindex="0" class="btn btn-outline btn-circle btn-sm border-current/10 text-base" role="button" aria-label="AI"><iconify-icon icon="mdi:stars-outline" class="iconify" noobserver></iconify-icon></div>
              <ul tabindex="-1" class="dropdown-content menu menu-sm my-2 border border-white/5 outline outline-black/5 w-52 bg-base-200 rounded-box shadow-2xl">
                <li><a href="#" @click.prevent="document.activeElement.blur()"><iconify-icon icon="mdi:content-copy" class="text-base iconify" noobserver></iconify-icon> Copy docs</a></li>
                <li></li>
                <li><a href="#" @click.prevent="document.activeElement.blur()"><iconify-icon icon="arcticons:openai-chatgpt" class="text-base iconify" noobserver></iconify-icon> Open in ChatGPT</a></li>
                <li><a href="#" @click.prevent="document.activeElement.blur()"><iconify-icon icon="arcticons:claude" class="text-base iconify" noobserver></iconify-icon> Open in Claude</a></li>
                <li><a href="#" @click.prevent="document.activeElement.blur()"><iconify-icon icon="arcticons:google-gemini" class="text-base iconify" noobserver></iconify-icon> Open in Gemini</a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      {#- PREVIEW -#}
      <div
        x-show="tabActive === 1"
        x-transition:enter.opacity.duration.500ms
        x-transition:leave.opacity.duration.0ms
        :id="tabId +'-'+ '1' +'-panel'"
        :aria-labelledby="tabId +'-'+ '1'"
        role="tabpanel"
        style="display: none;"
      >
        <div class="border-x border-t border-base-300 overflow-auto relative rounded-t-box">
          <div
            data-theme="light"
            x-html="previewRendered"
            class="preview-scope p-6 bg-base-100 flex items-center justify-center bg-artboard"
            :class="'min-h-['+ previewHeight +'rem]'"
          >
          </div>
        </div>
        <div class="relative">
          <div class="mockup-code mb-6 bg-grid rounded-t-none before:hidden">
            <pre data-prefix="&lt;!-- html --&gt;" class="language-html px-6 max-h-72 text-sm overflow-y-scroll"><code x-ref="codeBlock" x-text="codeRendered"></code></pre>
            <div class="flex items-center gap-2 absolute top-1 right-1">
              <button @click="inspectMode = !inspectMode" class="btn btn-outline btn-circle btn-xs border-current/20 text-base">
                <iconify-icon icon="mdi:select-search" class="iconify" noobserver></iconify-icon>
              </button>
              <button
                @click="
                  navigator.clipboard.writeText(codeRendered).then(() => {
                    $el.textContent = 'Copied!';
                    setTimeout(() => $el.textContent = 'Copy', 2000);
                  })
                "
                class="btn btn-outline btn-xs border-current/20"
              >
                Copy
              </button>
            </div>
          </div>
        </div>
        {#- CONTROLS -#}
        <div>
          <div class="mb-1 flex items-center justify-between">
            {{ heading({ slot: 'Controls' }) }}
            <div class="tooltip" data-tip="Restore">
              <button @click="restoreDefaults" class="btn btn-ghost btn-circle btn-xs text-lg" aria-label="Restore default values"><iconify-icon icon="mdi:restore" class="iconify" noobserver></iconify-icon></button>
            </div>
          </div>
          <div class="border border-base-300 max-h-[25rem] bg-base-100 overflow-hidden overflow-y-scroll rounded-box after:h-16 after:bg-(--color-base-100) after:text-current/50 after:flex after:items-end after:justify-center after:pointer-events-none after:sticky after:bottom-0 after:[mask-image:linear-gradient(transparent,#000000)] after:content-['⇣_⇣']">
            <div class="pt-2 px-6 divide-y divide-(--color-base-300)">
              {%- for c in controls %}
                <div class="prs-form-control-col py-4">
                  <div class="prs-label prs-label-alt">
                    <label for="id-{{ c.name | slugify }}{{ '-1' if c.type === 'radio' }}" class="prs-label-text">{{ c.label or c.name | capitalize }}</label>
                    {%- if c.desc %}  
                      <span class="max-w-xs text-base-content/60 text-xs font-normal text-pretty">{{ c.desc }}</span>
                    {%- endif %}
                  </div>
                  <div class="prs-form-control">
                    {%- if c.type === 'select' %}
                      <select id="id-{{ c.name | slugify }}" x-model="{{ c.name }}" class="select select-sm appearance-none">
                        {%- for opt in c.options %}
                          <option value="{{ opt }}">{{ opt | title }}</option>
                        {%- endfor %}
                      </select>
                    {%- elseif c.type === 'radio' %}
                      {%- for opt in c.options %}
                        <label class="prs-radio-label">
                          <input type="radio" id="id-{{ c.name | slugify }}-{{ loop.index }}" name="name-{{ c.name | slugify }}" value="{{ opt }}" x-model="{{ c.name }}" class="radio radio-sm" />
                          <span class="text-sm">{{ opt | title }}</span>
                        </label>
                      {%- endfor %}
                    {%- elseif c.type === 'toggle' %}
                      <input type="checkbox" id="id-{{ c.name | slugify }}" x-model="{{ c.name }}" class="toggle toggle-sm" />
                    {%- elseif c.type === 'range' %}
                      <input type="range" min="{{ c.min }}" max="{{ c.max }}" step="{{ c.step }}" value="{{ c.name }}" class="range" />
                    {%- elseif c.type === 'text' or c.type == 'number' %}
                      <input type="{{ c.type }}" id="id-{{ c.name | slugify }}" x-model="{{ c.name }}" class="input input-sm" placeholder="{{ c.placeholder | default('Value') }}" />
                    {%- endif %}
                  </div>
                </div>
              {%- endfor %}
            </div>
          </div>
        </div>
      </div>

      {#- INSPECT -#}
      <div
        @keydown.escape.window="inspectMode = false"
        x-show="inspectMode"
        x-transition
        class="border border-(--color-base-content)/25 w-80 max-h-[60vh] text-xs bg-neutral text-neutral-content font-mono overflow-auto fixed top-1/2 right-6 z-50 -translate-y-1/2 rounded-box shadow-xl shadow-current/10"
      >
        <div class="border-b border-(--color-neutral-content)/10 py-2 pr-1.5 pl-4 bg-neutral font-semibold flex justify-between items-center sticky top-0 z-10">
          <span>Inspector</span>
          <button @click="inspectMode = false" class="btn btn-ghost btn-circle btn-xs text-lg">&times;</button>
        </div>

        <template x-if="selectedEl" hidden>
          <div class="p-4 text-[85%] leading-none">
            <div x-show="selectedEl">
              <div class="text-current/60 mb-4">
                <span x-text="selectedEl.className ? '.' + selectedEl.className.split(' ').join('.') : ''"></span>
              </div>
  
              <div class="inspect-spacing mb-3 text-base-content text-center [&_.space-unit]:p-1">
                <div class="inpect-m border border-dashed border-current/30 bg-base-300 grid grid-cols-[auto_1fr_auto] items-center relative">
                  <p class="text-current/60 absolute top-1 left-1">margin</p>
                  <div class="space-unit col-span-3" x-text="getComputed('margin-top')"></div>
                  <div class="space-unit" x-text="getComputed('margin-left')"></div>
                  <div>
                    <div class="inpect-b border border-dashed border-current/30 bg-base-200 grid grid-cols-[auto_1fr_auto] items-center relative">
                      <p class="text-current/60 absolute top-1 left-1">border</p>
                      <div class="space-unit col-span-3" x-text="getComputed('border-top-width')"></div>
                      <div class="space-unit" x-text="getComputed('border-left-width')"></div>
                      <div>
                        <div class="inpect-p border border-dashed border-current/30 bg-base-100 grid grid-cols-[auto_1fr_auto] items-center relative">
                          <p class="text-current/60 absolute top-1 left-1">padding</p>
                          <div class="space-unit col-span-3" x-text="getComputed('padding-top')"></div>
                          <div class="space-unit" x-text="getComputed('padding-left')"></div><div class="border border-dashed border-current/30 p-0.5 bg-neutral text-neutral-content">&nbsp;{#<span x-text="getComputed('min-width')">w</span> &times; <span x-text="getComputed('min-height')">h</span>#}</div><div class="space-unit" x-text="getComputed('padding-right')"></div>
                          <div class="space-unit col-span-3" x-text="getComputed('padding-bottom')"></div>
                        </div>
                      </div>
                      <div class="space-unit" x-text="getComputed('border-right-width')"></div>
                      <div class="space-unit col-span-3" x-text="getComputed('border-bottom-width')"></div>
                    </div>
                  </div>
                  <div class="space-unit" x-text="getComputed('margin-right')"></div>
                  <div class="space-unit col-span-3" x-text="getComputed('margin-bottom')"></div>
                </div>
              </div>
  
              <div class="grid grid-cols-1 divide-y divide-current/10">
                <div class="py-1.5 grid grid-cols-2">
                  <div class="text-current/60">border-color:</div>
                  <div><span x-text="getComputed('border-color')"></span></div>
                </div>
                <div class="py-1.5 grid grid-cols-2">
                  <div class="text-current/60">background-color:</div>
                  <div><span x-text="getComputed('background-color')"></span></div>
                </div>
                <div class="py-1.5 grid grid-cols-2">
                  <div class="text-current/60">color:</div>
                  <div><span x-text="getComputed('color')"></span></div>
                </div>
                <div class="py-1.5 grid grid-cols-2">
                  <div class="text-current/60">text:</div>
                  <div><div x-text="getComputed('font')"></div></div>
                </div>
                <div class="py-1.5 grid grid-cols-2">
                  <div class="text-current/60">border-radius:</div>
                  <div><div x-text="getComputed('border-radius')"></div></div>
                </div>
              </div>
            </div>
          </div>
        </template>
        <div x-show="!selectedEl" class="text-current/60 italic py-4 text-center">
          Click an element in the preview.
        </div>
      </div>

      {#- STYLES -#}
      <div
        x-show="tabActive === 2"
        x-transition:enter.opacity.duration.500ms
        x-transition:leave.opacity.duration.0ms
        :id="tabId +'-'+ '2' +'-panel'"
        :aria-labelledby="tabId +'-'+ '2'"
        role="tabpanel"
        style="display: none;"
      >
        <div class="mockup-code bg-grid">
          <pre data-prefix="/* css */" class="language-css px-6 max-h-72 text-sm overflow-y-scroll"><code x-ref="stylesBlock">{{ styles }}</code></pre>
          <button
            @click="
              navigator.clipboard.writeText($refs.stylesBlock.textContent).then(() => {
                $el.textContent = 'Copied!';
                setTimeout(() => $el.textContent = 'Copy', 2000);
              })
            "
            class="absolute top-1 right-1 btn btn-outline border-current/50 border-dashed btn-xs"
          >
            Copy
          </button>
        </div>
      </div>
    </div>

  </div>

  {%- set codeLogic -%}
    {%- for placeholder, replacement in code.logic %}
      html = html.replace(/{ {{- placeholder | safe -}} }/g, {{ replacement | safe }});
    {%- endfor %}
  {%- endset -%}
  {%- set controlsDefault -%}
    {%- for c in controls %}
      {{ c.name }}: {{ c.default | dump | safe }},
    {%- endfor %}
  {%- endset -%}
  <script>
    function story(config) {
      return {
        ...config,
        previewHeight: 10,
        inspectMode: false,
        selectedEl: null,
        hoveredEl: null,
        selectedElClasses: [],

        updateInspector() {
          if (!this.selectedEl) {
            this.selectedElClasses = [];
            return;
          }
          this.selectedElClasses = this.selectedEl.classList;
        },

        rgbToHex(color) {
          if (!color) return '—';
          if (color === 'transparent' ||
              color === 'currentColor' ||
              color === 'inherit' ||
              color === 'initial' ||
              color === 'unset') {
            return color;
          }
          if (color === 'rgba(0, 0, 0, 0)' ||
              color === 'rgba(0,0,0,0)' ||
              color === 'rgb(0 0 0 / 0)' ||
              color.replace(/\s+/g, '') === 'rgba(0,0,0,0)') {
            return 'transparent';
          }
          if (!color.startsWith('rgb')) {
            return color;
          }
          const matches = color.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)/);
          if (!matches) {
            return color;
          }
          const r = parseInt(matches[1], 10);
          const g = parseInt(matches[2], 10);
          const b = parseInt(matches[3], 10);
          const hex = '#' +
            [r, g, b]
              .map(x => x.toString(16).padStart(2, '0'))
              .join('')
              .toUpperCase();

          return hex;
        },

        getCleanStyle(el, prop) {
          if (!el) return '—';
          const clone = el.cloneNode(true);
          clone.style.position = 'absolute';
          clone.style.left = '-9999px';
          clone.style.top = '-9999px';
          clone.style.visibility = 'hidden';
          clone.style.pointerEvents = 'none';
          clone.style.userSelect = 'none';
          document.body.appendChild(clone);
          void clone.offsetWidth;
          const styles = window.getComputedStyle(clone);
          let value = styles.getPropertyValue(prop).trim();
          document.body.removeChild(clone);
          return value || '—';
        },

        getComputed(prop) {
          const raw = this.getCleanStyle(this.selectedEl, prop);
          if (prop.includes('color') && raw.startsWith('rgb')) {
            return this.rgbToHex(raw);
          }
          if (prop === 'font') {
            const styles = window.getComputedStyle(this.selectedEl);
            return `${styles.fontSize.replace('px','')} / ${styles.lineHeight.replace('px','')}`;
          }
          return raw.replace('px', '') || '—';
        },

        clickHandler(e) {
          if (!this.inspectMode) return;
          e.preventDefault();
          e.stopPropagation();
          const target = e.target.closest('[class]') || this.$el.querySelector('[x-html="previewRendered"]');
          this.selectedEl = target;
          this.selectedElClasses = Array.from(target.classList);
          this.$nextTick(() => this.updateInspector());
        },

        get previewRendered() {
          let html = `{{ preview | safe }}`;
          return html;
        },

        get codeRendered() {
          let html = `{{ code.html | safe }}`;
          {{ codeLogic | safe }}
          return html.trim();
        },

        syncFromUrl() {
          const params = new URLSearchParams(window.location.search);
          Object.keys(this.defaults || {}).forEach(key => {
            const value = params.get(key);
            if (value !== null) {
              if (typeof this[key] === 'boolean') {
                this[key] = value === 'true';
              } else if (typeof this[key] === 'number') {
                this[key] = Number(value);
              } else {
                this[key] = value;
              }
            }
          });
        },

        syncToUrl() {
          // console.log('[syncToUrl] Current state:', this);
          const params = new URLSearchParams();
          let hasChanges = false;

          Object.keys(this.defaults || {}).forEach(key => {
            const value = this[key];
            const defaultValue = this.defaults[key];
            // console.log(`  ${key}: ${value} (default: ${defaultValue})`);

            if (value !== defaultValue) {
              params.set(key, value);
              hasChanges = true;
            }
          });

          const newSearch = params.toString();
          // console.log('[syncToUrl] New search string:', newSearch);

          const newUrl = newSearch ? `${window.location.pathname}?${newSearch}` : window.location.pathname;

          if (newUrl !== window.location.href) {
            // console.log('[syncToUrl] Updating URL to:', newUrl);
            window.history.replaceState({}, '', newUrl);
          } else {
            // console.log('[syncToUrl] No change needed');
          }
        },

        restoreDefaults() {
          Object.keys(this.defaults).forEach(key => {
            this[key] = this.defaults[key];
          });
          this.syncToUrl();
        },

        initDefaults() {
          this.defaults = {
            {{ controlsDefault | safe }}
          };
        },

        init() {
          this.initDefaults();

          this.syncFromUrl();

          this.$watch('inspectMode', (enabled) => {
            if (!enabled) {
              this.selectedEl = null;
            }
          });

          const preview = this.$el.querySelector('[x-html="previewRendered"]');
          if (preview) {
            preview.addEventListener('click', (e) => this.clickHandler(e));
          };

          this.$watch(
            () => JSON.stringify(this),
            (newVal, oldVal) => {
              this.syncToUrl();
            },
            { deep: true }
          );

          this.$nextTick(() => {
            if (this.$refs.codeBlock) {
              this.$refs.codeBlock.removeAttribute('data-highlighted');
              hljs.highlightElement(this.$refs.codeBlock);
            }
            if (this.$refs.stylesBlock) {
              this.$refs.stylesBlock.removeAttribute('data-highlighted');
              hljs.highlightElement(this.$refs.stylesBlock);
            }
          });

          this.$watch('codeRendered', () => {
            this.$nextTick(() => {
              if (this.$refs.codeBlock) {
                this.$refs.codeBlock.removeAttribute('data-highlighted');
                hljs.highlightElement(this.$refs.codeBlock);
              }
            });
          });
        },
      };
    }
  </script>
{%- endif %}
