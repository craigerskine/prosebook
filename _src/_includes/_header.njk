<header class="contents bg-base-100 shrink-0 lg:flex lg:pointer-events-none lg:fixed lg:inset-0 lg:z-10">
  <div class="contents lg:border-r lg:border-(--color-base-300) lg:w-72 lg:flex lg:flex-col lg:gap-4 lg:overflow-y-auto lg:pointer-events-auto xl:w-80">
    <div class="border-b border-base-300 p-3 bg-base-100 flex items-center gap-2 sticky top-0 z-50 lg:border-b-0">
      <button @click.stop="menu = !menu" class="btn btn-ghost btn-circle group text-2xl lg:hidden" :class="menu && 'bg-base-300'" aria-controls="menu-main" :aria-expanded="menu" :aria-pressed="menu">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" class="w-4 h-4 fill-current pointer-events-none">
          <rect width="9" height="2" y="7" rx="1" class="origin-center -translate-y-[5px] translate-x-[7px] group-[[aria-pressed=true]]:translate-x-0 group-[[aria-pressed=true]]:translate-y-0 group-[[aria-pressed=true]]:rotate-[315deg] motion-safe:transition-all duration-300" />
          <rect width="16" height="2" y="7" rx="1" class="origin-center group-[[aria-pressed=true]]:rotate-45 motion-safe:transition-all duration-300" />
          <rect width="9" height="2" y="7" rx="1" class="origin-center translate-y-[5px] group-[[aria-pressed=true]]:translate-y-0 group-[[aria-pressed=true]]:rotate-[135deg] motion-safe:transition-all duration-300" />
        </svg>
      </button>
      <a href="{{ '/' | url }}" class="group flex flex-none items-center gap-2 transform transition hover:opacity-50">
        {%- set width = '8' -%}
        {%- include '_logo.njk' %}
      </a>
      <div class="ml-auto">
        <button @click="searchOpen()" class="btn btn-ghost btn-circle btn-sm text-xl" aria-label="Search"><iconify-icon icon="mdi:magnify" class="iconify" noobserver></iconify-icon></button>
        <div class="dropdown dropdown-end focus-within:[&_.btn]:bg-(--color-base-300)">
          <div tabindex="0" class="btn btn-ghost btn-sm pr-1 pl-1.5 gap-1 rounded-full">
            <span :data-theme="theme" class="border border-(--color-base-content)/10 p-0.5 w-5 h-5 bg-base-100 shrink-0 grid grid-cols-2 gap-0.5 rounded-md shadow-sm">
              <span class="bg-base-content rounded-xs"></span>
              <span class="bg-primary rounded-xs"></span>
              <span class="bg-secondary rounded-xs"></span>
              <span class="bg-accent rounded-xs"></span>
            </span>
            <iconify-icon icon="mdi:chevron-down" class="text-base iconify" noobserver></iconify-icon>
          </div>
          <div tabindex="-1" class="dropdown-content my-2 border border-white/5 h-[30.5rem] max-h-[calc(100vh-8.6rem)] outline outline-black/5 bg-base-100 overflow-y-auto rounded-box shadow-2xl">
            <ul class="menu w-52">
              <li class="menu-title text-xs">Theme</li>
              {%- for item in site.themes %}
                <li>
                  <a href="#{{ item }}" @click.prevent="setTheme('{{ item }}', $event); document.activeElement.blur();" :class="theme === '{{ item }}' && 'menu-active'">
                    <span data-theme="{{ item }}" class="border border-(--color-base-content)/10 p-0.5 w-5 h-5 bg-base-100 shrink-0 grid grid-cols-2 gap-0.5 rounded-md shadow-sm">
                      <span class="bg-base-content rounded-xs"></span>
                      <span class="bg-primary rounded-xs"></span>
                      <span class="bg-secondary rounded-xs"></span>
                      <span class="bg-accent rounded-xs"></span>
                    </span>
                    {{ item | title }}
                    <iconify-icon x-show="theme === '{{ item }}'" icon="mdi:check" class="iconify text-base" noobserver style="display: none;"></iconify-icon>
                  </a>
                </li>
              {%- endfor %}
            </ul>
          </div>
        </div>
      </div>
    </div>
    {%- include '_nav.njk' -%}
  </div>
</header>
